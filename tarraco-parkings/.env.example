# Copia este archivo a .env y cambia las contraseñas antes de desplegar.
# .env no se versiona: contiene credenciales.

APP_ENV=development
APP_URL=https://tarraco.local
APP_TIMEZONE=Europe/Madrid

# DB_NAME debe coincidir con el nombre que crea db/init.sql (tarraco_parkings).
# Si se cambia aquí, hay que cambiarlo también allí.
DB_HOST=db
DB_PORT=3306
DB_NAME=tarraco_parkings
DB_USER=tarraco
DB_PASSWORD=cambia_esta_clave
DB_ROOT_PASSWORD=cambia_esta_raiz

HTTP_PORT=80
HTTPS_PORT=443
PMA_PORT=8080

GRAFANA_USER=admin
GRAFANA_PASSWORD=cambia_esta_clave
