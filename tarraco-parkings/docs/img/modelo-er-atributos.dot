      <TR><TD ALIGN="LEFT">fecha_inicio_vigencia <FONT COLOR="#7F8C8D">DATE</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
