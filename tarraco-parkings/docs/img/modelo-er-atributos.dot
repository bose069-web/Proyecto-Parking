      <TR><TD ALIGN="LEFT">planta <FONT COLOR="#7F8C8D">INT</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">tipo_plaza <FONT COLOR="#7F8C8D">ENUM</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
