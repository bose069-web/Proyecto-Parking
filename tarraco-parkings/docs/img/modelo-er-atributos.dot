    </TABLE>>];
  CLIENTE -> VEHICULO [label="tiene\n1 : 0..*"];
  CLIENTE -> METODO_PAGO [label="registra\n1 : 0..*"];
  CLIENTE -> RESERVA [label="realiza\n1 : 0..*"];
  VEHICULO -> RESERVA [label="se reserva en\n1 : 0..*"];
  PARKING -> PLAZA [label="contiene\n1 : 0..*"];
  PARKING -> TARIFA [label="aplica\n1 : 0..*"];
  PARKING -> RESERVA [label="recibe\n1 : 0..*"];
  PLAZA -> RESERVA [label="se asigna a\n0..1 : 0..*"];
  TARIFA -> RESERVA [label="valoriza\n1 : 0..*"];
  RESERVA -> PAGO [label="genera\n1 : 1..*"];
  METODO_PAGO -> PAGO [label="cobra con\n1 : 0..*"];
  RESERVA -> REGISTRO_ACCESO [label="origina\n0..1 : 0..*"];
  VEHICULO -> REGISTRO_ACCESO [label="protagoniza\n0..1 : 0..*"];
  PARKING -> REGISTRO_ACCESO [label="ocurre en\n1 : 0..*"];
  ADMINISTRADOR -> REGISTRO_AUDITORIA [label="ejecuta\n0..1 : 0..*"];
  { rank=same; CLIENTE; PARKING; ADMINISTRADOR; }
  { rank=same; VEHICULO; METODO_PAGO; PLAZA; TARIFA; }
  { rank=same; RESERVA; }
  { rank=same; PAGO; REGISTRO_ACCESO; REGISTRO_AUDITORIA; }
}