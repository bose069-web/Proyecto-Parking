digraph MODELO {
  graph [rankdir=LR, splines=true, nodesep=0.45, ranksep=1.15,
         fontname="Helvetica", bgcolor="transparent", pad=0.25];
  node [shape=plaintext, fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=8, color="#40566E",
        fontcolor="#40566E", arrowsize=0.7, penwidth=1.1];
  CLIENTE [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2C3E50" BGCOLOR="#FFFFFF">
      <TR><TD COLSPAN="2" BGCOLOR="#E8F1FB"><FONT POINT-SIZE="11"><B>CLIENTE</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">id_cliente <FONT COLOR="#7F8C8D">INT</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#B03A2E" POINT-SIZE="7">PK</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">nombre <FONT COLOR="#7F8C8D">VARCHAR(50)</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">apellidos <FONT COLOR="#7F8C8D">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">email <FONT COLOR="#7F8C8D">VARCHAR(120)</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">UQ NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">telefono <FONT COLOR="#7F8C8D">VARCHAR(20)</FONT></TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">documento_ident <FONT COLOR="#7F8C8D">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">UQ NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">password_hash <FONT COLOR="#7F8C8D">VARCHAR(255)</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">fecha_registro <FONT COLOR="#7F8C8D">DATETIME</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">estado <FONT COLOR="#7F8C8D">ENUM</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
    </TABLE>>];
  VEHICULO [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2C3E50" BGCOLOR="#FFFFFF">
      <TR><TD COLSPAN="2" BGCOLOR="#F7F9FC"><FONT POINT-SIZE="11"><B>VEHICULO</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">id_vehiculo <FONT COLOR="#7F8C8D">INT</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#B03A2E" POINT-SIZE="7">PK</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">id_cliente <FONT COLOR="#7F8C8D">INT</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6C3483" POINT-SIZE="7">FK NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">matricula <FONT COLOR="#7F8C8D">VARCHAR(10)</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">UQ NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">marca <FONT COLOR="#7F8C8D">VARCHAR(50)</FONT></TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">modelo <FONT COLOR="#7F8C8D">VARCHAR(50)</FONT></TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">color <FONT COLOR="#7F8C8D">VARCHAR(30)</FONT></TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">tipo_vehiculo <FONT COLOR="#7F8C8D">ENUM</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">activo <FONT COLOR="#7F8C8D">TINYINT(1)</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
    </TABLE>>];
  METODO_PAGO [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2C3E50" BGCOLOR="#FFFFFF">
      <TR><TD COLSPAN="2" BGCOLOR="#F7F9FC"><FONT POINT-SIZE="11"><B>METODO_PAGO</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">id_metodo_pago <FONT COLOR="#7F8C8D">INT</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#B03A2E" POINT-SIZE="7">PK</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">id_cliente <FONT COLOR="#7F8C8D">INT</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#6C3483" POINT-SIZE="7">FK NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">tipo <FONT COLOR="#7F8C8D">ENUM</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">descripcion <FONT COLOR="#7F8C8D">VARCHAR(60)</FONT></TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">token <FONT COLOR="#7F8C8D">VARCHAR(255)</FONT></TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">por_defecto <FONT COLOR="#7F8C8D">TINYINT(1)</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">activo <FONT COLOR="#7F8C8D">TINYINT(1)</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
    </TABLE>>];
  PARKING [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2C3E50" BGCOLOR="#FFFFFF">
      <TR><TD COLSPAN="2" BGCOLOR="#EAF4F0"><FONT POINT-SIZE="11"><B>PARKING</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">id_parking <FONT COLOR="#7F8C8D">INT</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#B03A2E" POINT-SIZE="7">PK</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">nombre <FONT COLOR="#7F8C8D">VARCHAR(80)</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">direccion <FONT COLOR="#7F8C8D">VARCHAR(150)</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">ciudad <FONT COLOR="#7F8C8D">VARCHAR(50)</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">descripcion <FONT COLOR="#7F8C8D">VARCHAR(255)</FONT></TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">capacidad_total <FONT COLOR="#7F8C8D">INT</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">horario <FONT COLOR="#7F8C8D">VARCHAR(80)</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
      <TR><TD ALIGN="LEFT">latitud <FONT COLOR="#7F8C8D">DECIMAL(10,7)</FONT></TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">longitud <FONT COLOR="#7F8C8D">DECIMAL(10,7)</FONT></TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">activo <FONT COLOR="#7F8C8D">TINYINT(1)</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#7F8C8D" POINT-SIZE="7">NN</FONT></TD></TR>
    </TABLE>>];
  PLAZA [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2C3E50" BGCOLOR="#FFFFFF">
      <TR><TD COLSPAN="2" BGCOLOR="#F7F9FC"><FONT POINT-SIZE="11"><B>PLAZA</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">id_plaza <FONT COLOR="#7F8C8D">INT</FONT></TD><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#B03A2E" POINT-SIZE="7">PK</FONT></TD></TR>
